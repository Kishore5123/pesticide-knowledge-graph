pkg:MCPA a pkg:ActiveSubstance,
        owl:NamedIndividual ;
    rdfs:label "MCPA" ;
    pkg:adi 0.05 ;
    pkg:approvalDate "2006-05-01"^^xsd:date ;
    pkg:approvalStatus "Approved" ;
    pkg:arfd 0.15 ;
    pkg:casNumber "94-74-6" ;
    pkg:euFunction "HB" ;
    pkg:expiryDate "2028-07-31"^^xsd:date ;
    pkg:hasDenominator pkg:MCPA ;
    pkg:inchiKey "WHKUVVPPKQRRBV-UHFFFAOYSA-N" ;
    pkg:molecularFormula "C9H9ClO3" ;
    pkg:pubchemCID "7204" .

pkg:isFormOf a owl:ObjectProperty ;
    rdfs:subPropertyOf pkg:hasDenominator .

pkg:ActiveSubstance a owl:Class ;
    rdfs:subClassOf pkg:ChemicalEntity .

pkg:ChemicalEntity a owl:Class .

