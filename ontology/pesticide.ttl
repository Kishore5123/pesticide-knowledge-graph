    pkg:molecularFormula "C9H11Cl3NO3PS" ;
    pkg:pubchemCID "2730" .

pkg:Glyphosate a pkg:ActiveSubstance,
        owl:NamedIndividual ;
    rdfs:label "Glyphosate" ;
    pkg:adi 0.5 ;
    pkg:approvalDate "2023-12-16"^^xsd:date ;
    pkg:approvalStatus "Approved" ;
    pkg:arfd 1.5 ;
    pkg:casNumber "1071-83-6" ;
    pkg:euFunction "HB" ;
    pkg:expiryDate "2033-12-15"^^xsd:date ;
    pkg:hasDenominator pkg:Glyphosate ;
    pkg:inchiKey "XDDAORKBJWWYJS-UHFFFAOYSA-N" ;
